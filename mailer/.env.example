# ABBA Mailer — environment variables
# Copy the values into Coolify's "Environment Variables" for this service.
# Do NOT commit real values — this file is only a template.

# Port the service listens on (Coolify maps this)
PORT=3000

# Brevo API key — from Brevo dashboard > SMTP & API > API Keys > Generate a new key.
# (This is the v3 API key, NOT the SMTP key. We use the API because the host
#  blocks the SMTP ports.)
BREVO_API_KEY=your-brevo-v3-api-key

# Who mail is sent AS. Must be on your Brevo-verified domain.
MAIL_FROM=ABBA Global Corp <info@abbaglobalcorp.com>

# Where lead notifications are delivered (your inbox)
MAIL_TO=info@abbaglobalcorp.com

# Which website origins may call this service (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://abbaglobalcorp.com,https://www.abbaglobalcorp.com

# One-pager file (defaults are fine if you keep the file in assets/)
# ONE_PAGER_PATH=./assets/AGC_1Pgr_7.23.26.pdf
# ONE_PAGER_FILENAME=ABBA-Global-Corp-One-Pager.pdf
